rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Data model:
    // - users/{uid}: private preferences and activity summary.
    // - users/{uid}/resourceActivity/{resourceId}: private open history.
    // - dailyActivity/{YYYY-MM-DD}-{uid}: administrator-only daily summary.
    // - resourceStats/{resourceId}: administrator-only aggregate analytics
    //   with catalog metadata and bounded UID lists/counts for each action.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
          || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
          || request.resource.data.uid == resource.data.uid;
    }

    // The admin claim is issued only with the Admin SDK. The two verified
    // owner identities are intentionally bootstrapped for this school app.
    function isEastsidePrepAdmin() {
      return isAuthenticated()
          && request.auth.token.email is string
          && request.auth.token.email_verified == true
          && (request.auth.token.email in [
                'apan@eastsideprep.org',
                'alyssa.pannn@gmail.com'
              ]
              || (request.auth.token.email.matches('^[^@]+@eastsideprep\\.org$')
                  && request.auth.token.admin == true));
    }

    function hasVerifiedMatchingEmail() {
      return request.auth.token.email is string
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.email.size() <= 254;
    }

    function isAllowedActivityAction() {
      return request.resource.data.lastAction in [
        'Signed in',
        'Opened a resource',
        'Updated practice-test progress',
        'Updated saved resources',
        'Updated pinned resources',
        'Marked a resource as seen',
        'Updated pinned links',
        'Marked a link as seen',
        'Added a personal deadline',
        'Removed a personal deadline',
        'Updated selected majors'
      ];
    }

    function hasValidActivityFields() {
      let hasAnyActivityField = 'lastAction' in request.resource.data
          || 'lastActiveAt' in request.resource.data
          || 'lastActionAt' in request.resource.data;
      return !hasAnyActivityField || (
          request.resource.data.keys().hasAll([
            'lastAction', 'lastActiveAt', 'lastActionAt'
          ])
          && request.resource.data.lastAction is string
          && request.resource.data.lastAction.size() <= 80
          && isAllowedActivityAction()
          && request.resource.data.lastActiveAt is timestamp
          && request.resource.data.lastActionAt is timestamp
        );
    }

    function hasCurrentActivityTimestamps() {
      return !('lastAction' in request.resource.data) || (
        request.resource.data.lastActiveAt == request.time
        && request.resource.data.lastActionAt == request.time
      );
    }

    function hasUnchangedOrCurrentActivityTimestamps() {
      return !('lastAction' in request.resource.data) || (
        (request.resource.data.lastActiveAt == resource.data.lastActiveAt
            || request.resource.data.lastActiveAt == request.time)
        && (request.resource.data.lastActionAt == resource.data.lastActionAt
            || request.resource.data.lastActionAt == request.time)
      );
    }

    function isValidStudyData() {
      return request.resource.data.keys().hasOnly([
               'saved', 'pinned', 'seen', 'linkPinned', 'linkSeen',
               'completedTests', 'personalDeadlines', 'checkedMajors',
               'checkedMajorOrder', 'checkedSubMajorOrder', 'email',
               'lastActiveAt', 'lastAction', 'lastActionAt'
             ])
          && (!('saved' in request.resource.data) ||
              (request.resource.data.saved is list && request.resource.data.saved.size() <= 500))
          && (!('pinned' in request.resource.data) ||
              (request.resource.data.pinned is list && request.resource.data.pinned.size() <= 500))
          && (!('seen' in request.resource.data) ||
              (request.resource.data.seen is list && request.resource.data.seen.size() <= 1000))
          && (!('linkPinned' in request.resource.data) ||
              (request.resource.data.linkPinned is list && request.resource.data.linkPinned.size() <= 500))
          && (!('linkSeen' in request.resource.data) ||
              (request.resource.data.linkSeen is list && request.resource.data.linkSeen.size() <= 1000))
          && (!('completedTests' in request.resource.data) ||
              (request.resource.data.completedTests is map && request.resource.data.completedTests.size() <= 100))
          && (!('personalDeadlines' in request.resource.data) ||
              (request.resource.data.personalDeadlines is list && request.resource.data.personalDeadlines.size() <= 100))
          && (!('checkedMajors' in request.resource.data) ||
              (request.resource.data.checkedMajors is list && request.resource.data.checkedMajors.size() <= 100))
          && (!('checkedMajorOrder' in request.resource.data) ||
              (request.resource.data.checkedMajorOrder is list && request.resource.data.checkedMajorOrder.size() <= 100))
          && (!('checkedSubMajorOrder' in request.resource.data) ||
              (request.resource.data.checkedSubMajorOrder is list && request.resource.data.checkedSubMajorOrder.size() <= 500))
          && (!('email' in request.resource.data) || hasVerifiedMatchingEmail())
          && hasValidActivityFields();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isEastsidePrepAdmin();
      allow create: if isOwner(userId)
          && isValidStudyData()
          && hasCurrentActivityTimestamps();
      allow update: if isOwner(userId)
          && isValidStudyData()
          && hasUnchangedOrCurrentActivityTimestamps();
      allow delete: if isOwner(userId);
    }

    function isValidResourceActivity(resourceId) {
      return resourceId.size() <= 120
          && request.resource.data.keys().hasOnly(['lastOpenedAt', 'openCount'])
          && request.resource.data.keys().hasAll(['lastOpenedAt', 'openCount'])
          && request.resource.data.lastOpenedAt is timestamp
          && request.resource.data.lastOpenedAt == request.time
          && request.resource.data.openCount is int
          && request.resource.data.openCount >= 1
          && request.resource.data.openCount <= 10000;
    }

    match /users/{userId}/resourceActivity/{resourceId} {
      allow read: if isOwner(userId) || isEastsidePrepAdmin();
      allow create: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidResourceActivity(resourceId)
          && request.resource.data.openCount == 1;
      allow update: if isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidResourceActivity(resourceId)
          && request.resource.data.openCount == resource.data.openCount + 1;
    }

    function isValidDailyActivity(activityId) {
      return request.resource.data.keys().hasOnly([
               'uid', 'email', 'day', 'lastAction', 'lastActionAt'
             ])
          && request.resource.data.keys().hasAll([
               'uid', 'email', 'day', 'lastAction', 'lastActionAt'
             ])
          && request.resource.data.uid is string
          && request.resource.data.uid.size() <= 128
          && uidUnchanged()
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.email.size() <= 254
          && request.resource.data.day is string
          && request.resource.data.day.matches(
               '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'
             )
          && activityId == request.resource.data.day + '-' + request.auth.uid
          && request.resource.data.lastAction is string
          && request.resource.data.lastAction.size() <= 80
          && isAllowedActivityAction()
          && request.resource.data.lastActionAt is timestamp
          && request.resource.data.lastActionAt == request.time;
    }

    match /dailyActivity/{activityId} {
      allow read: if isEastsidePrepAdmin();
      allow create: if isAuthenticated() && isValidDailyActivity(activityId);
      allow update: if isAuthenticated()
          && uidNotModified()
          && isValidDailyActivity(activityId);
    }

    function isValidUidList(value) {
      return value is list
          && value.size() <= 1000
          && value.size() == value.toSet().size();
    }

    function isValidResourceCategory(category) {
      return category in [
        'act', 'ap', 'competition', 'dual_credit', 'internship', 'research', 'sat'
      ];
    }

    function isValidResourceStats(resourceId) {
      return request.resource.data.keys().hasAll([
               'resourceId', 'title', 'category', 'totalViews',
               'uniqueViewerCount', 'viewerUids', 'savedCount', 'savedUids',
               'pinnedCount', 'pinnedUids', 'seenCount', 'seenUids', 'updatedAt'
             ])
          && request.resource.data.keys().hasOnly([
               'resourceId', 'title', 'category', 'totalViews',
               'uniqueViewerCount', 'viewerUids', 'savedCount', 'savedUids',
               'pinnedCount', 'pinnedUids', 'seenCount', 'seenUids',
               'lastViewedAt', 'updatedAt'
             ])
          && request.resource.data.resourceId is string
          && request.resource.data.resourceId == resourceId
          && request.resource.data.resourceId.size() <= 120
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.category is string
          && isValidResourceCategory(request.resource.data.category)
          && request.resource.data.totalViews is int
          && request.resource.data.totalViews >= 0
          && request.resource.data.totalViews <= 1000000000
          && request.resource.data.uniqueViewerCount is int
          && request.resource.data.savedCount is int
          && request.resource.data.pinnedCount is int
          && request.resource.data.seenCount is int
          && isValidUidList(request.resource.data.viewerUids)
          && isValidUidList(request.resource.data.savedUids)
          && isValidUidList(request.resource.data.pinnedUids)
          && isValidUidList(request.resource.data.seenUids)
          && request.resource.data.uniqueViewerCount == request.resource.data.viewerUids.size()
          && request.resource.data.savedCount == request.resource.data.savedUids.size()
          && request.resource.data.pinnedCount == request.resource.data.pinnedUids.size()
          && request.resource.data.seenCount == request.resource.data.seenUids.size()
          && request.resource.data.totalViews >= request.resource.data.uniqueViewerCount
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && (!('lastViewedAt' in request.resource.data)
              || (request.resource.data.lastViewedAt is timestamp
                  && request.resource.data.lastViewedAt <= request.time));
    }

    function addsCurrentUid(before, after) {
      return !before.toSet().hasAny([request.auth.uid])
          && after.toSet().hasAny([request.auth.uid])
          && after.size() == before.size() + 1
          && after.toSet().hasAll(before);
    }

    function removesCurrentUid(before, after) {
      return before.toSet().hasAny([request.auth.uid])
          && !after.toSet().hasAny([request.auth.uid])
          && after.size() == before.size() - 1
          && before.toSet().hasAll(after);
    }

    function isValidViewStatsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let alreadyViewed = resource.data.viewerUids.toSet().hasAny([request.auth.uid]);
      return changed.hasOnly([
               'totalViews', 'uniqueViewerCount', 'viewerUids',
               'lastViewedAt', 'updatedAt'
             ])
          && request.resource.data.totalViews == resource.data.totalViews + 1
          && request.resource.data.lastViewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && ((alreadyViewed
                  && request.resource.data.viewerUids == resource.data.viewerUids
                  && request.resource.data.uniqueViewerCount == resource.data.uniqueViewerCount)
              || (!alreadyViewed
                  && addsCurrentUid(resource.data.viewerUids, request.resource.data.viewerUids)
                  && request.resource.data.uniqueViewerCount == resource.data.uniqueViewerCount + 1));
    }

    function isValidSavedStatsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['savedCount', 'savedUids', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((addsCurrentUid(resource.data.savedUids, request.resource.data.savedUids)
                  && request.resource.data.savedCount == resource.data.savedCount + 1)
              || (removesCurrentUid(resource.data.savedUids, request.resource.data.savedUids)
                  && request.resource.data.savedCount == resource.data.savedCount - 1));
    }

    function isValidPinnedStatsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['pinnedCount', 'pinnedUids', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((addsCurrentUid(resource.data.pinnedUids, request.resource.data.pinnedUids)
                  && request.resource.data.pinnedCount == resource.data.pinnedCount + 1)
              || (removesCurrentUid(resource.data.pinnedUids, request.resource.data.pinnedUids)
                  && request.resource.data.pinnedCount == resource.data.pinnedCount - 1));
    }

    function isValidSeenStatsUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['seenCount', 'seenUids', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((addsCurrentUid(resource.data.seenUids, request.resource.data.seenUids)
                  && request.resource.data.seenCount == resource.data.seenCount + 1)
              || (removesCurrentUid(resource.data.seenUids, request.resource.data.seenUids)
                  && request.resource.data.seenCount == resource.data.seenCount - 1));
    }

    match /resourceStats/{resourceId} {
      allow read: if isEastsidePrepAdmin();
      allow create: if isEastsidePrepAdmin()
          && isValidResourceStats(resourceId);
      allow update: if isValidResourceStats(resourceId)
          && (isEastsidePrepAdmin()
              || (isAuthenticated()
                  && request.resource.data.resourceId == resource.data.resourceId
                  && request.resource.data.title == resource.data.title
                  && request.resource.data.category == resource.data.category
                  && (isValidViewStatsUpdate()
                      || isValidSavedStatsUpdate()
                      || isValidPinnedStatsUpdate()
                      || isValidSeenStatsUpdate())));
      allow delete: if isEastsidePrepAdmin();
    }
  }
}
